{
  "name": "Python test",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "downloads",
    "downloads.open",
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}